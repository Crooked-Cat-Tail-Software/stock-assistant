# Build context for the root Dockerfile is the whole repo: keep secrets, local
# state, dependencies, and test output out of it.
.git
.env
.env.*
**/.env
**/node_modules
**/.venv
**/__pycache__
**/*.db
**/.pytest_cache
**/.ruff_cache
frontend/dist
frontend/coverage
frontend/test-results
frontend/playwright-report
backend/tests
security
spikes

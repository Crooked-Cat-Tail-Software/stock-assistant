# Rendered at container start: ${VARS} are substituted from the environment
# (defaults are set in the Dockerfile).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Client IP. In Compose nothing is trusted (127.0.0.1/32), so $remote_addr is
    # the real peer and a client-supplied X-Forwarded-For is ignored. Behind a
    # platform load balancer (Render), TRUSTED_PROXY_CIDR=0.0.0.0/0 takes the
    # last X-Forwarded-For entry, the one added by the load balancer.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    # TEMPORARY diagnostic (remove after fixing client-IP detection on Render):
    # shows the caller only the address information nginx sees for their own
    # request. No secrets, and no other visitors' data.
    location = /__whoami {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"remote_addr":"$remote_addr","realip_remote_addr":"$realip_remote_addr","x_forwarded_for":"$http_x_forwarded_for","cf_connecting_ip":"$http_cf_connecting_ip","true_client_ip":"$http_true_client_ip","x_real_ip":"$http_x_real_ip"}\n';
    }

    # Which commit this frontend was built from; CI checks it after deploying.
    location = /version {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "${RENDER_GIT_COMMIT}\n";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers. The app loads only its own scripts, styles, and API.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Send the backend's own hostname: platforms like Render route by Host,
        # and HTTPS backends need it for SNI.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        # Shared secret proving the request came through this proxy (empty = not sent).
        proxy_set_header X-Internal-Token "${INTERNAL_API_TOKEN}";
        # Overwrite (not append) so clients can't spoof their IP to dodge the rate limit.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The agent can take ~30 s; allow some headroom.
        proxy_read_timeout 90s;
        client_max_body_size 64k;
    }

    # Hashed build assets never change, so let browsers cache them for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        # add_header in a location replaces the server-level ones, so repeat them.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve index.html.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri /index.html;
    }
}

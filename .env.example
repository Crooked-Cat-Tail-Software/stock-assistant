# Copy to .env and fill in. Never commit .env.

# Required for real agent answers (not needed for tests)
OPENAI_API_KEY=sk-...
ALPHAVANTAGE_API_KEY=your-free-key   # https://www.alphavantage.co/support/#api-key
OPENAI_MODEL=gpt-4.1-mini

# Database: SQLite for local dev; docker-compose overrides this with Postgres
DATABASE_URL=sqlite:///./dev.db

# "openai" = real agent, "fake" = canned replies (no keys needed, used by tests/CI)
AGENT_MODE=openai

# Guardrails
RATE_LIMIT_PER_MINUTE=10
